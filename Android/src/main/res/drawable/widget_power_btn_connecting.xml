<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- soft outer glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="28dp"
                android:startColor="#4DFF5FB0"
                android:centerColor="#1FFF5FB0"
                android:endColor="#00FF5FB0" />
        </shape>
    </item>

    <!-- glass circle + ring -->
    <item
        android:left="6dp" android:top="6dp"
        android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#402A1240" />
            <stroke android:width="1.8dp" android:color="#CCFF5FB0" />
        </shape>
    </item>

    <!-- icon -->
    <item
        android:left="14dp" android:top="14dp"
        android:right="14dp" android:bottom="14dp"
        android:drawable="@drawable/ic_widget_power_glyph" />
</layer-list>
