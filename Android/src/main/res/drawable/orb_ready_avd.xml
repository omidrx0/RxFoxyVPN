<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/orb_ready_vec">
<target android:name="aura"><aapt:attr name="android:animation"><set><objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.08" android:valueType="floatType" android:duration="2500" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /><objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1.08" android:valueType="floatType" android:duration="2500" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /></set></aapt:attr></target>
<target android:name="fox_bob"><aapt:attr name="android:animation"><objectAnimator android:propertyName="translateY" android:valueFrom="0" android:valueTo="-2.2" android:valueType="floatType" android:duration="1250" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /></aapt:attr></target>
<target android:name="fox_body"><aapt:attr name="android:animation"><set><objectAnimator android:propertyName="scaleX" android:valueFrom="0.98" android:valueTo="1.02" android:valueType="floatType" android:duration="2500" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /><objectAnimator android:propertyName="scaleY" android:valueFrom="0.97" android:valueTo="1.03" android:valueType="floatType" android:duration="2500" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /></set></aapt:attr></target>
<target android:name="fox_tail"><aapt:attr name="android:animation"><objectAnimator android:propertyName="rotation" android:valueFrom="-4" android:valueTo="4" android:valueType="floatType" android:duration="1800" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /></aapt:attr></target>
<target android:name="fox_head"><aapt:attr name="android:animation"><objectAnimator android:propertyName="rotation" android:valueFrom="-4.4" android:valueTo="0.4" android:valueType="floatType" android:duration="3500" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /></aapt:attr></target>
<target android:name="arcs"><aapt:attr name="android:animation"><objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="360" android:valueType="floatType" android:duration="16000" android:repeatCount="-1" android:repeatMode="restart" android:interpolator="@android:interpolator/linear" /></aapt:attr></target>
<target android:name="icon"><aapt:attr name="android:animation"><set><objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.07" android:valueType="floatType" android:duration="1500" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /><objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1.07" android:valueType="floatType" android:duration="1500" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /></set></aapt:attr></target>
<target android:name="icon_main"><aapt:attr name="android:animation"><objectAnimator android:propertyName="strokeAlpha" android:valueFrom="1" android:valueTo="0.88" android:valueType="floatType" android:duration="1500" android:repeatCount="-1" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" /></aapt:attr></target>
<target android:name="tail_glint"><aapt:attr name="android:animation"><set><objectAnimator android:propertyName="trimPathStart" android:valueFrom="0" android:valueTo="0.9" android:valueType="floatType" android:duration="3400" android:repeatCount="-1" android:repeatMode="restart" android:interpolator="@android:interpolator/accelerate_decelerate" /><objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0.1" android:valueTo="1" android:valueType="floatType" android:duration="3400" android:repeatCount="-1" android:repeatMode="restart" android:interpolator="@android:interpolator/accelerate_decelerate" /></set></aapt:attr></target>
</animated-vector>
